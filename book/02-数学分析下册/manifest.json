  "glossary": [
    {
      "term": "部分和",
      "def": "级数前 n 项之和，级数收敛指它收敛",
      "chapterId": "ch12"
    },
    {
      "term": "正项级数",
      "def": "每项非负的级数，部分和单调递增",
      "chapterId": "ch12"
    },
    {
      "term": "比值判别法",
      "def": "用相邻项比的极限判断敛散",
      "chapterId": "ch12"
    },
    {
      "term": "拉贝判别法",
      "def": "比值法失效时用 n(u_n/u_{n+1}-1) 判敛",
      "chapterId": "ch12"
    },
    {
      "term": "绝对收敛",
      "def": "绝对值级数收敛",
      "chapterId": "ch12"
    },
    {
      "term": "点态收敛",
      "def": "每点各自收敛，N 可依赖 x",
      "chapterId": "ch13"
    },
    {
      "term": "一致收敛",
      "def": "整段区间共用一个 N",
      "chapterId": "ch13"
    },
    {
      "term": "M 判别法",
      "def": "通项被收敛数项级数控制则一致收敛",
      "chapterId": "ch13"
    },
    {
      "term": "收敛半径",
      "def": "幂级数收敛区间的半长",
      "chapterId": "ch14"
    },
    {
      "term": "阿贝尔定理",
      "def": "一点收敛则内点绝对收敛，一点发散则外点发散",
      "chapterId": "ch14"
    },
    {
      "term": "傅里叶系数",
      "def": "函数与三角基函数的内积除以基函数平方积分",
      "chapterId": "ch15"
    },
    {
      "term": "狄利克雷条件",
      "def": "连续或有限个第一类间断点、有限个极值点",
      "chapterId": "ch15"
    },
    {
      "term": "重极限",
      "def": "所有路径趋近都给出同一极限",
      "chapterId": "ch16"
    },
    {
      "term": "累次极限",
      "def": "先对一个变量取极限再对另一个",
      "chapterId": "ch16"
    },
    {
      "term": "聚点",
      "def": "任意去心邻域含集合中的点",
      "chapterId": "ch16"
    },
    {
      "term": "偏导数",
      "def": "只让一个变量变化时的变化率",
      "chapterId": "ch17"
    },
    {
      "term": "可微",
      "def": "增量可由线性函数逼近，误差为高阶小量",
      "chapterId": "ch17"
    },
    {
      "term": "梯度",
      "def": "偏导构成的向量，指向最陡上升方向",
      "chapterId": "ch17"
    },
    {
      "term": "黑塞矩阵",
      "def": "二阶偏导构成的对称矩阵",
      "chapterId": "ch17"
    },
    {
      "term": "雅可比行列式",
      "def": "坐标变换的局部伸缩比例",
      "chapterId": "ch18"
    },
    {
      "term": "条件极值",
      "def": "在约束下求极值，用拉格朗日乘数法",
      "chapterId": "ch18"
    },
    {
      "term": "含参量积分",
      "def": "被积函数或积分限依赖参数的积分",
      "chapterId": "ch19"
    },
    {
      "term": "Γ 函数",
      "def": "阶乘的连续推广，Γ(s+1)=sΓ(s)",
      "chapterId": "ch19"
    },
    {
      "term": "B 函数",
      "def": "与 Γ 函数关联的一类积分，B=ΓΓ/Γ",
      "chapterId": "ch19"
    },
    {
      "term": "第一型曲线积分",
      "def": "对弧长的积分，与方向无关",
      "chapterId": "ch20"
    },
    {
      "term": "第二型曲线积分",
      "def": "对坐标的积分，反向变号",
      "chapterId": "ch20"
    },
    {
      "term": "达布和",
      "def": "区域分割后取上确界或下确界构成的和",
      "chapterId": "ch21"
    },
    {
      "term": "格林公式",
      "def": "闭曲线积分等于区域上 Q_x-P_y 的二重积分",
      "chapterId": "ch21"
    },
    {
      "term": "路径无关",
      "def": "曲线积分只与端点有关，等价于存在势函数",
      "chapterId": "ch21"
    },
    {
      "term": "高斯公式",
      "def": "闭曲面通量等于体内散度的三重积分",
      "chapterId": "ch22"
    },
    {
      "term": "斯托克斯公式",
      "def": "空间闭曲线环量等于曲面上旋度的积分",
      "chapterId": "ch22"
    },
    {
      "term": "散度",
      "def": "向量场各分量偏导之和，描述源的强度",
      "chapterId": "ch22"
    },
    {
      "term": "旋度",
      "def": "描述向量场局部旋转的向量",
      "chapterId": "ch22"
    },
    {
      "term": "雅可比矩阵",
      "def": "向量函数的导数，元素为偏导",
      "chapterId": "ch23"
    }
  ],
