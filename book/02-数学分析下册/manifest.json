    },
    {
      "id": "q02",
      "chapterId": "ch12",
      "type": "single",
      "question": "∑1/[n(n+1)] 的和是？",
      "options": [
        "1",
        "2",
        "发散",
        "1/2"
      ],
      "answer": 0,
      "explain": "裂项为 1/n-1/(n+1)，部分和 1-1/(n+1)→1。"
    },
    {
      "id": "q03",
      "chapterId": "ch13",
      "type": "single",
      "question": "f_n(x)=x^n 在 [0,1] 上？",
      "options": [
        "一致收敛于 0",
        "点态收敛但不一致收敛",
        "不收敛",
        "一致收敛于 1"
      ],
      "answer": 1,
      "explain": "x<1 时趋于 0，x=1 时为 1；sup|x^n-0|=1 不趋于 0。",
      "relatedConceptId": "c07"
    },
    {
      "id": "q04",
      "chapterId": "ch13",
      "type": "single",
      "question": "∑cos(nx)/n³ 在 R 上一致收敛吗？",
      "options": [
        "是，用 M 判别法",
        "否，通项不趋于 0",
        "只在 [0,1] 上",
        "无法判断"
      ],
      "answer": 0,
      "explain": "|cos nx/n³|≤1/n³，∑1/n³ 收敛，由 M 判别法。",
      "relatedConceptId": "c07"
    },
    {
      "id": "q05",
      "chapterId": "ch14",
      "type": "single",
      "question": "∑x^n/2^n 的收敛半径是？",
      "options": [
        "1/2",
        "1",
        "2",
        "∞"
      ],
      "answer": 2,
      "explain": "a_n=2^{-n}，L=1/2，R=2。"
    },
    {
