  "quizzes": [
    {
      "id": "q01",
      "chapterId": "ch01",
      "type": "single",
      "question": "E={1-1/n: n=1,2,...} 的上确界是？",
      "options": [
        "0",
        "1",
        "不存在",
        "2"
      ],
      "answer": 1,
      "explain": "所有项小于 1，且可任意接近 1，1 是最小上界，但不属于 E。",
      "relatedConceptId": "c01"
    },
    {
      "id": "q02",
      "chapterId": "ch01",
      "type": "single",
      "question": "{x∈Q: x²<2} 在有理数范围内有上确界吗？",
      "options": [
        "有，是 2",
        "有，是 √2",
        "没有",
        "无法判断"
      ],
      "answer": 2,
      "explain": "√2 不是有理数，最小有理上界不存在，说明有理数集不满足确界原理。",
      "relatedConceptId": "c01"
    },
    {
      "id": "q03",
      "chapterId": "ch02",
      "type": "single",
      "question": "收敛数列一定满足？",
      "options": [
        "单调",
        "有界",
        "从某项起等于极限",
        "有上界无下界"
      ],
      "answer": 1,
      "explain": "收敛必有界；单调与恒等都不是必要条件。",
      "relatedConceptId": "c02"
    },
    {
      "id": "q04",
      "chapterId": "ch02",
      "type": "single",
      "question": "a_n=(-1)^n 是柯西列吗？",
      "options": [
        "是，因为有界",
        "是，因为没有极限",
        "不是，取 ε=1 可找到相距 2 的两项",
        "无法判断"
      ],
      "answer": 2,
      "explain": "相邻异号项之差为 2，任意 N 之后都能找到，违反柯西条件。",
      "relatedConceptId": "c02"
    },
    {
      "id": "q05",
      "chapterId": "ch03",
      "type": "single",
      "question": "lim(x→0) sin3x/x 等于？",
      "options": [
        "0",
        "1",
        "3",
        "不存在"
      ],
      "answer": 2,
      "explain": "sin3x/x = 3·sin3x/(3x) → 3。",
      "relatedConceptId": "c02"
    },
    {
      "id": "q06",
      "chapterId": "ch03",
      "type": "single",
      "question": "lim(x→0) sin(1/x) 存在吗？",
      "options": [
        "存在，等于 0",
        "存在，等于 1",
        "不存在，可取两列趋近方式得到不同值",
        "只在右侧存在"
      ],
      "answer": 2,
      "explain": "取 1/(2nπ) 得 0，取 1/(2nπ+π/2) 得 1，由海涅定理知极限不存在。",
      "relatedConceptId": "c02"
    },
    {
      "id": "q07",
      "chapterId": "ch04",
      "type": "single",
      "question": "(x²-1)/(x-1) 在 x=1 处属于？",
      "options": [
        "连续",
        "可去间断",
        "跳跃间断",
        "无穷间断"
      ],
      "answer": 1,
      "explain": "化简为 x+1，极限为 2，但函数在 1 处无定义，补定义即可连续。",
      "relatedConceptId": "c03"
    },
    {
      "id": "q08",
      "chapterId": "ch04",
      "type": "single",
      "question": "1/x 在 (0,1) 上不一致连续，理由是？",
      "options": [
        "它不连续",
        "它无界且靠近 0 处变化率无统一控制",
        "它没有反函数",
        "它在 1 处间断"
      ],
      "answer": 1,
      "explain": "取 x_n=1/n、y_n=1/(n+1)，差值趋于 0 但函数值差恒为 1。",
      "relatedConceptId": "c03"
    },
    {
      "id": "q09",
      "chapterId": "ch05",
      "type": "single",
      "question": "|x| 在 x=0 处？",
      "options": [
        "可导且导数为 0",
        "连续但不可导",
        "不连续",
        "可导且导数为 1"
      ],
      "answer": 1,
      "explain": "左右导数分别为 -1 与 1，不相等。",
      "relatedConceptId": "c04"
    },
    {
      "id": "q10",
      "chapterId": "ch05",
      "type": "single",
      "question": "y=ln sin x 的导数是？",
      "options": [
        "cot x",
        "tan x",
        "cos x",
        "1/sin x"
      ],
      "answer": 0,
      "explain": "复合求导 (1/sin x)·cos x = cot x。",
      "relatedConceptId": "c04"
    },
    {
      "id": "q11",
      "chapterId": "ch06",
      "type": "single",
      "question": "x³ 在 [-1,1] 上拉格朗日定理的中值 ξ 是？",
      "options": [
        "0",
        "1/√3",
        "1/2",
        "不存在"
      ],
      "answer": 1,
      "explain": "3ξ²·2=2，ξ²=1/3，取正根。",
      "relatedConceptId": "c04"
    },
    {
      "id": "q12",
      "chapterId": "ch06",
      "type": "single",
      "question": "lim(x→0)(e^x-1-x)/x² 等于？",
      "options": [
        "0",
        "1/2",
        "1",
        "不存在"
      ],
      "answer": 1,
      "explain": "泰勒展开 e^x=1+x+x²/2+o(x²)，比值趋于 1/2。",
      "relatedConceptId": "c04"
    },
    {
      "id": "q13",
      "chapterId": "ch07",
      "type": "single",
      "question": "下列哪条不属于实数完备性定理？",
      "options": [
        "确界原理",
        "致密性定理",
        "洛必达法则",
        "柯西准则"
      ],
      "answer": 2,
      "explain": "洛必达是求极限的工具，不是完备性定理。",
      "relatedConceptId": "c01"
    },
    {
      "id": "q14",
      "chapterId": "ch07",
      "type": "single",
      "question": "a_n=(-1)^n(1+1/n) 的上极限是？",
      "options": [
        "-1",
        "0",
        "1",
        "不存在"
      ],
      "answer": 2,
      "explain": "偶数项趋于 1，奇数项趋于 -1，上极限取最大者 1。",
      "relatedConceptId": "c01"
    },
    {
      "id": "q15",
      "chapterId": "ch08",
      "type": "single",
      "question": "∫dx/(x ln x) 等于？",
