  "glossary": [
    {
      "term": "上确界",
      "def": "全体上界里最小的那个数",
      "chapterId": "ch01"
    },
    {
      "term": "确界原理",
      "def": "非空有上界的实数集必有上确界",
      "chapterId": "ch01"
    },
    {
      "term": "去心邻域",
      "def": "挖掉中心点的邻域，用于定义极限",
      "chapterId": "ch01"
    },
    {
      "term": "ε-N 定义",
      "def": "任给 ε>0，存在 N，n>N 时数列项与极限差小于 ε",
      "chapterId": "ch02"
    },
    {
      "term": "柯西列",
      "def": "任给 ε>0，存在 N，m,n>N 时两项之差小于 ε",
      "chapterId": "ch02"
    },
    {
      "term": "单调有界准则",
      "def": "单调有界数列必收敛",
      "chapterId": "ch02"
    },
    {
      "term": "海涅定理",
      "def": "函数极限存在的充要条件是所有数列趋近方式给出同一极限",
      "chapterId": "ch03"
    },
    {
      "term": "无穷小",
      "def": "极限为 0 的变量",
      "chapterId": "ch03"
    },
    {
      "term": "等价无穷小",
      "def": "比值极限为 1 的两个无穷小",
      "chapterId": "ch03"
    },
    {
      "term": "可去间断点",
      "def": "左右极限相等但不等于函数值的间断点",
      "chapterId": "ch04"
    },
    {
      "term": "跳跃间断点",
      "def": "左右极限都存在但不相等",
      "chapterId": "ch04"
    },
    {
      "term": "一致连续",
      "def": "整个区间共用一个 δ 的连续性",
      "chapterId": "ch04"
    },
    {
      "term": "导数",
      "def": "差商的极限，几何上是切线斜率",
      "chapterId": "ch05"
    },
    {
      "term": "微分",
      "def": "函数增量的线性主部，dy=f'(x)dx",
      "chapterId": "ch05"
    },
    {
      "term": "罗尔定理",
      "def": "端点相等且连续可导，则区间内导数为零",
      "chapterId": "ch06"
    },
    {
      "term": "拉格朗日中值定理",
      "def": "平均变化率等于某点瞬时变化率",
      "chapterId": "ch06"
    },
    {
      "term": "洛必达法则",
      "def": "0/0 或 ∞/∞ 型极限用导数比计算",
      "chapterId": "ch06"
    },
    {
      "term": "区间套定理",
      "def": "长度趋于 0 的嵌套闭区间有唯一公共点",
      "chapterId": "ch07"
    },
    {
      "term": "聚点",
      "def": "任意邻域含集合中无穷多个点",
      "chapterId": "ch07"
    },
    {
      "term": "上极限",
      "def": "所有收敛子列极限的最大者",
      "chapterId": "ch07"
    },
    {
      "term": "原函数",
      "def": "导数为给定函数的函数",
      "chapterId": "ch08"
    },
    {
      "term": "换元积分法",
      "def": "通过变量替换把积分化成基本公式",
      "chapterId": "ch08"
    },
    {
      "term": "分部积分法",
      "def": "由乘积求导公式移项得到的积分法",
      "chapterId": "ch08"
    },
    {
      "term": "达布和",
      "def": "小区间上取上确界或下确界构成的和",
      "chapterId": "ch09"
    },
    {
      "term": "牛顿-莱布尼茨公式",
      "def": "定积分等于原函数在两端点的差",
      "chapterId": "ch09"
    },
    {
      "term": "积分中值定理",
      "def": "连续函数在区间上存在一点使积分为函数值乘区间长",
      "chapterId": "ch09"
    },
    {
      "term": "微元法",
      "def": "把目标量切成小片写出近似再积分",
      "chapterId": "ch10"
    },
    {
      "term": "曲率",
      "def": "单位弧长上切线转过的角度",
      "chapterId": "ch10"
    },
    {
      "term": "无穷积分",
      "def": "积分区间无限的定积分，由极限定义",
      "chapterId": "ch11"
    },
    {
      "term": "瑕积分",
      "def": "被积函数在瑕点无界的积分",
      "chapterId": "ch11"
    },
    {
      "term": "条件收敛",
      "def": "本身收敛但绝对值积分发散",
      "chapterId": "ch11"
    }
  ],
